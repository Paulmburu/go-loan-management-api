# ==============================================================================
# DATABASE_URL BREAKDOWN:
# postgres:// [Protocol]  - Tells Go to use the PostgreSQL driver
# postgres    [Username]  - The database user
# :postgres   [Password]  - The password for that user (separated by a colon)
# @localhost  [Host]      - Where the DB is running (your local machine)
# :5432       [Port]      - The standard port for PostgreSQL
# /go_loan_management_api  - The specific name of the database
?sslmode=disable         - Disables encryption (use 'require' in production)
# ==============================================================================
# FORMAT: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_loan_management_api?sslmode=disable
DATABASE_URL=postgres://paul:DEVELOPER@localhost:5432/go_loan_management_api?sslmode=disable

# The port the Go server will listen on
APP_PORT=8080
JWT_SECRET=super-secret-change-this
JWT_EXPIRY_HOURS=24